    "fmt": "biome format . --write",
    "test": "NODE_OPTIONS='--no-deprecation' vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "^5",
