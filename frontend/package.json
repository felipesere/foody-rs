    "@tanstack/react-query-devtools": "^5",
    "@tanstack/react-query-persist-client": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/react-table": "^8",
    "@tanstack/router-devtools": "^1",
    "classnames": "^2",
    "fuse.js": "^7",
    "ky": "^2",
    "react": "^19",
    "react-dom": "^19",
    "react-speech-recognition": "^4",
    "sonner": "^2",
    "valibot": "^1"
  },
  "devDependencies": {
    "@biomejs/biome": "=2.5.5",
    "@playwright/test": "^1",
    "@tanstack/router-vite-plugin": "^1",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-speech-recognition": "^3",
